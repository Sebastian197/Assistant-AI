{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "assistant-ai",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write resources/js vite.config.ts eslint.config.ts",
        "format:check": "prettier --check resources/js vite.config.ts eslint.config.ts"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@vue-flow/core": "^1.48.2",
        "axios": "^1.20.0",
        "pinia": "^4.1.0",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    }
}
